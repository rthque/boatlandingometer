diff --git a/lib/fine-profiles.ts b/lib/fine-profiles.ts
new file mode 100644
index 0000000..ab531f3
--- /dev/null
+++ b/lib/fine-profiles.ts
@@ -0,0 +1,19 @@
+import {MeshStandardMaterial} from 'three';
+/** Visual coverage only. Source mesh, LAT picking and collision remain metric.
+ * Radius grows only when below 0.7 physical px, capped at +3 cm. No scaling of
+ * the whole jacket. Camera-near profiles retain their measured CAD section.
+ */
+export function stabilizeProfiles(material:MeshStandardMaterial,pixelWorld:{value:number}){
+ const previous=material.onBeforeCompile.bind(material),key=material.customProgramCacheKey.bind(material);
+ const previousKey=key();
+ material.onBeforeCompile=(shader,renderer)=>{
+  previous(shader,renderer);shader.uniforms.bloPixelWorld=pixelWorld;
+  shader.vertexShader='attribute vec3 _blo_radial; attribute float _blo_radius; uniform float bloPixelWorld;\n'+shader.vertexShader;
+  shader.vertexShader=shader.vertexShader.replace('#include <begin_vertex>',`#include <begin_vertex>
+   float bloDepth=max(0.0,-(modelViewMatrix*vec4(position,1.0)).z);
+   float bloExpand=clamp(bloDepth*bloPixelWorld*0.7-_blo_radius,0.0,0.03);
+   float bloScale=max(length(mat3(modelMatrix)*_blo_radial),0.00001);
+   transformed+=_blo_radial*bloExpand/bloScale;`);
+ };
+ material.customProgramCacheKey=()=>previousKey+'-stable-profiles-v1';material.needsUpdate=true;
+}
diff --git a/lib/foundation-finish.ts b/lib/foundation-finish.ts
new file mode 100644
index 0000000..d499e01
--- /dev/null
+++ b/lib/foundation-finish.ts
@@ -0,0 +1,12 @@
+import {Mesh,MeshStandardMaterial,type Group,type Material} from 'three';
+import {applyStructureMarkings} from './structure-markings.ts';
+import {stabilizeProfiles} from './fine-profiles.ts';
+export function finishFoundation(root:Group,water:{value:number},target:{value:number},pixelWorld:{value:number},safe:boolean){
+ root.traverse(o=>{if(o instanceof Mesh){
+  const fine=!!o.geometry.getAttribute('_blo_radial');
+  const finish=(original:Material)=>{const mat=(original as MeshStandardMaterial).clone();mat.roughness=Math.max(.5,mat.roughness);if(mat.name==='Acier jaune')mat.metalness=.22;applyStructureMarkings(mat,water,target,true,safe);if(fine&&!safe)stabilizeProfiles(mat,pixelWorld);return mat;};
+  // Keep single materials single: an array on a geometry without groups would
+  // suppress every draw, despite a successfully loaded and raycastable mesh.
+  o.material=Array.isArray(o.material)?o.material.map(finish):finish(o.material);
+ }});
+}
diff --git a/lib/render-quality.ts b/lib/render-quality.ts
new file mode 100644
index 0000000..efa5153
--- /dev/null
+++ b/lib/render-quality.ts
@@ -0,0 +1,11 @@
+/** Slow hysteresis avoids alternating resolutions and never moves the camera. */
+export function adaptiveResolution(initial=2){
+ let ratio=Math.min(2,Math.max(1,initial)),fast=0,slow=0;
+ return {get ratio(){return ratio;},sample(fps:number){
+  if(!Number.isFinite(fps)||fps<=0)return ratio;
+  slow=fps<48?slow+1:0;fast=fps>57?fast+1:0;
+  if(slow>=2&&ratio>1){ratio=Math.max(1,ratio-.25);slow=fast=0;}
+  else if(fast>=4&&ratio<2){ratio=Math.min(2,ratio+.25);slow=fast=0;}
+  return ratio;
+ }};
+}
